ENV ETCD_ADVERTISE_CLIENT_URLS=http://0.0.0.0:2379
ENV ETCD_LISTEN_PEER_URLS=http://0.0.0.0:2380
ENV ETCD_INITIAL_ADVERTISE_PEER_URLS=http://0.0.0.0:2380
ENV ETCD_INITIAL_CLUSTER_TOKEN=etcd-cluster-1
