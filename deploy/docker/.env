# LingQuickRec 环境配置
# 修改此文件后执行 docker compose up -d 即可生效
#
# 完整参数说明见 CONFIG.md
# 配置级别：必须指定 / 允许调整 / 不建议修改（不在此处列出）

# ---- 服务发现（允许调整） ----
DISCOVERY_PORT=8100
PROXY_PORT=8080

# ---- vLLM（允许调整） ----
VLLM_PORT=8000
VLLM_ENDPOINT=/v1/chat/completions
MODEL_NAME=/app/models/Qwen3-0.6B/
VLLM_TIMEOUT_MS=100000
SKU_COUNT=100

# ---- Precalc（允许调整） ----
PRECALC_KVWORKER_HOST=141.61.84.245
PRECALC_KVWORKER_PORT=31502
PRECALC_ETCD_ADDRESS=141.61.84.245:2379
TTL_SECONDS=5
PRECALC_RESULT_SIZE_MB=8.5
PAYLOAD_SIZE_KB=100

# ---- Rank（允许调整） ----
RANKSUB_KVWORKER_HOST=141.61.84.245
RANKSUB_KVWORKER_PORT=31502
RANKSUB_ETCD_ADDRESS=141.61.84.245:2379
RANK_SUB_REPLICAS=3
SUB_WORKER_COUNT=3
TOP_K=100
SCORING_DELAY_MS=100
