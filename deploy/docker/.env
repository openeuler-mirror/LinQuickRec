# LingQuickRec 环境配置
# 修改此文件后执行 docker compose up -d 即可生效
#
# 完整参数说明见 CONFIG.md
# 配置级别：必须指定 / 允许调整 / 不建议修改（不在此处列出）

# ============================================================================
# 全局配置
# ============================================================================

# ---- 服务发现模式 ----
# etcd（默认）：使用 etcd 集群做服务注册，适合生产环境，高可用
#   查看已注册服务：docker exec etcd etcdctl get /linquickrec/services/ --prefix
# discovery_server：自定义 BRPC 服务发现，适合快速部署和测试
# 切换方式：修改 REGISTRY_BACKEND，同时确保对应后端容器已启动
REGISTRY_BACKEND=etcd
ETCD_ENDPOINTS=etcd:2379
DISCOVERY_PORT=8100
DISCOVERY_ADDR=discovery-server:8100

# ---- 网关 ----
PROXY_PORT=8080

# ============================================================================
# etcd（服务注册中心）
# ============================================================================
ETCD_PORT=2379                        # etcd 客户端端口
ETCD_PEER_PORT=2380                   # etcd 集群通信端口

# ============================================================================
# Discovery Server
# ============================================================================

# ---- Server 参数 ----
# SERVER_PORT=8100                    # 监听端口（不建议修改）
HEARTBEAT_CHECK_INTERVAL_MS=1000     # 健康检查扫描间隔 (ms)
HEARTBEAT_GRACE_FACTOR=2.0           # 心跳超时倍数
CLEANUP_FACTOR=5.0                   # 清理倍数
DEFAULT_HEARTBEAT_INTERVAL_SEC=5     # 默认心跳间隔 (秒)

# ---- BRPC Server 参数 ----
SERVER_NUM_THREADS=0                 # bthread 工作线程数，0=BRPC 默认(CPU 核数)
SERVER_IDLE_TIMEOUT_SEC=-1           # 空闲连接超时(秒)，-1=BRPC 默认
SERVER_MAX_CONCURRENCY=0             # 最大并发请求数，0=不限制

# ============================================================================
# KV Worker（元戎 Datasystem，precalc/rank-sub 通过服务发现连接）
# ============================================================================
KV_WORKER_ADDRESS=kv-worker:31501    # Worker 地址（容器名:端口）
ENABLE_URMA=0                        # 是否启用 URMA (0/1)
CPU_AFFINITY=0-64                    # CPU 核绑定范围

# ============================================================================
# Proxy
# ============================================================================

# ---- Server 参数 ----
# SERVER_PORT=8080                    # 由 PROXY_PORT 控制（不建议修改）
DISCOVERY_REFRESH_INTERVAL_MS=5000   # Discovery 缓存刷新间隔 (ms)
FEATURE_SERVICE_NAME=feature_service # Feature 服务注册名
RECALL_SERVICE_NAME=recall_service   # Recall 服务注册名
PRECALC_SERVICE_NAME=precalc_service # Precalc 服务注册名
RANK_SERVICE_NAME=rank_service       # Rank 服务注册名

# ---- 下游通道共享参数 ----
DOWNSTREAM_CONNECTION_TYPE=pooled    # 连接类型 (single/pooled/short)
DOWNSTREAM_MAX_RETRY=3               # BRPC 重试次数
DOWNSTREAM_CONNECT_TIMEOUT_MS=-1     # TCP 建连超时(ms)，-1=禁用
DOWNSTREAM_LB_POLICY=                # 负载均衡策略 (rr/wrr/random/la)，空=默认rr

# ---- 下游通道按服务超时 ----
FEATURE_TIMEOUT_MS=30000              # Feature RPC 超时 (ms)
RECALL_TIMEOUT_MS=100000               # Recall RPC 超时 (ms)
PRECALC_TIMEOUT_MS=50000             # Precalc RPC 超时 (ms)
RANK_TIMEOUT_MS=100000                # Rank RPC 超时 (ms)

# ---- Backup Request（高延迟场景优化）----
FEATURE_BACKUP_REQUEST_MS=-1         # Feature backup request 延迟阈值(ms)，-1=禁用
RECALL_BACKUP_REQUEST_MS=-1          # Recall backup request 延迟阈值(ms)，-1=禁用
PRECALC_BACKUP_REQUEST_MS=-1         # Precalc backup request 延迟阈值(ms)，-1=禁用
RANK_BACKUP_REQUEST_MS=-1            # Rank backup request 延迟阈值(ms)，-1=禁用

# ============================================================================
# Feature (mock)
# ============================================================================

# ---- 业务参数 ----
USER_LOG_COUNT=10                    # 每次响应的用户日志数量
USER_LOG_VEC_SIZE=30                 # 每条用户日志向量大小
SKU_FEAT_LENGTH=20                   # SKU 特征字符串长度

# ============================================================================
# Recall
# ============================================================================

# ---- vLLM 配置 ----
VLLM_PORT=8000                       # vLLM 服务端口
VLLM_ENDPOINT=/v1/chat/completions   # vLLM 聊天接口端点
MODEL_NAME=/app/models/Qwen3-0.6B/   # 模型名称/路径
VLLM_TIMEOUT_MS=100000               # vLLM RPC 超时 (ms)
VLLM_STARTUP_TIMEOUT=120             # vLLM 启动等待超时 (秒)
VLLM_BASE_URL=http://127.0.0.1:8000  # vLLM 基础 URL（容器内）

# ---- vLLM 连接参数 ----
VLLM_CONNECTION_TYPE=pooled          # 到 vLLM 的连接类型 (single/pooled/short)
VLLM_MAX_RETRY=3                     # 到 vLLM 的重试次数
VLLM_CONNECT_TIMEOUT_MS=-1           # TCP 建连超时(ms)，-1=禁用
VLLM_BACKUP_REQUEST_MS=-1            # Backup request 延迟阈值(ms)，-1=禁用

# ---- 业务参数 ----
SKU_COUNT=100                        # 返回的 SKU ID 数量

# ============================================================================
# Precalc
# ============================================================================

# ---- 业务参数 ----
TTL_SECONDS=100                        # KV 缓存 TTL 时间（秒）
PRECALC_RESULT_SIZE_MB=8.5           # 前置计算结果大小 (MB)
PAYLOAD_SIZE_KB=100                  # Payload 大小 (KB)

# ============================================================================
# RankMaster
# ============================================================================

# ---- 业务参数 ----
TOP_K=100                            # 返回前 K 个商品
SUB_WORKER_SERVICE_TYPE=rank_sub     # RankSub 注册服务类型名
SUB_WORKER_PARALLELISM=4             # 并发分桶数
SUB_WORKER_COUNT=3                   # RankSub 副本数（需配合 docker compose --scale）

# ---- RankMaster → RankSub 连接参数 ----
SUB_WORKER_CONNECTION_TYPE=pooled    # 到 RankSub 的连接类型 (single/pooled/short)
SUB_WORKER_MAX_RETRY=3               # 到 RankSub 的重试次数
SUB_WORKER_CONNECT_TIMEOUT_MS=-1     # TCP 建连超时(ms)，-1=禁用
SUB_WORKER_BACKUP_REQUEST_MS=-1      # Backup request 延迟阈值(ms)，-1=禁用
SUB_WORKER_TIMEOUT_MS=5000           # RankSub 调用超时 (ms)
SUB_WORKER_LB_POLICY=                # Sub-worker 负载均衡策略 (rr/wrr/random/la)，空=默认rr
SUB_WORKER_ADDRESSES=rank-sub-service:8005  # RankSub 地址列表

# ---- 启动依赖 ----
RANK_SUB_STARTUP_TIMEOUT=120         # 等待 RankSub 就绪超时 (秒)

# ============================================================================
# RankSub（可水平扩展）
# ============================================================================

# ---- 业务参数 ----
SCORING_DELAY_MS=100                 # 模拟打分耗时 (ms)
RANK_SUB_REPLICAS=3                  # 副本数（docker-compose.yml 中 deploy.replicas）

# ============================================================================
# Discovery Client（所有服务的 sidecar）
# ============================================================================

# ---- 心跳与健康检查 ----
HEARTBEAT_INTERVAL=5                 # 心跳间隔 (秒)
HEALTH_CHECK_TIMEOUT=2               # TCP 探测超时 (秒)
FAIL_THRESHOLD=3                     # 连续失败次数阈值
STARTUP_TIMEOUT=30                   # 等待主服务就绪超时 (秒)