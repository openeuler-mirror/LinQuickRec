# LingQuickRec Docker Compose 构建配置
# 修改此文件后执行 docker compose build 即可生效
#
# 容器运行时配置（端口、超时、sleep 等）见 deploy/k8s/01-configmap.yaml

# ============================================================================
# Recall / Perf-collector 构建参数
# ============================================================================
ENABLE_VLLM=false          # true=vLLM 模式（需 GPU），false=novllm 模式

# 代理配置：Recall（ENABLE_VLLM=true，pip install）和 Perf-collector（yum install）构建时需要
PROXY_IP=                  # 代理 IP
PROXY_PORT=3128            # 代理端口，默认 3128
