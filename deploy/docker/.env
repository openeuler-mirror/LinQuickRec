# LingQuickRec 环境配置
# 修改此文件后重新执行 docker compose up -d 即可生效
#
# 注意：rank-sub 扩展副本后需同步修改以下三项：
#   RANK_SUB_REPLICAS、SUB_WORKER_COUNT、SUB_WORKER_ADDRESSES

# ---- 服务发现 ----
DISCOVERY_PORT=8100

# ---- 外部依赖 ----
KVWORKER_HOST=141.61.84.245
KVWORKER_PORT=31502
ETCD_ADDRESS=141.61.84.245:2379

# ---- vLLM 模型 ----
VLLM_PORT=8000
VLLM_ENDPOINT=/v1/chat/completions
MODEL_NAME=/app/models/Qwen3-0.6B/
VLLM_TIMEOUT_MS=100000
VLLM_STARTUP_TIMEOUT=120
SKU_COUNT=100

# ---- Precalc ----
TTL_SECONDS=100
PRECALC_RESULT_SIZE_MB=8.5
PAYLOAD_SIZE_KB=100

# ---- Rank ----
RANK_SUB_REPLICAS=3
SUB_WORKER_COUNT=3
SUB_WORKER_ADDRESSES=rank-sub-service:8006
TOP_K=100
SUB_WORKER_TIMEOUT_MS=5000
SCORING_DELAY_MS=100
RANK_SUB_STARTUP_TIMEOUT=120

# ---- Proxy 网关 ----
PROXY_PORT=8080
