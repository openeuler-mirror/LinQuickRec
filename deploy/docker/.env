# LingQuickRec 环境配置
# 修改此文件后执行 docker compose up -d 即可生效
#
# 完整参数说明见 CONFIG.md

# ---- 服务发现 ----
DISCOVERY_PORT=8100
PROXY_PORT=8080

# ---- 外部依赖（🚨 环境相关） ----
KVWORKER_HOST=141.61.84.245
KVWORKER_PORT=31502
ETCD_ADDRESS=141.61.84.245:2379

# ---- vLLM 模型（🔧 模型路径更改后需重新构建） ----
VLLM_PORT=8000
VLLM_ENDPOINT=/v1/chat/completions
MODEL_NAME=/app/models/Qwen3-0.6B/
VLLM_TIMEOUT_MS=100000
VLLM_STARTUP_TIMEOUT=120
SKU_COUNT=100

# ---- Precalc（🔧 常用调参） ----
TTL_SECONDS=5
PRECALC_RESULT_SIZE_MB=8.5
PAYLOAD_SIZE_KB=100

# ---- Rank（🔧 常用调参） ----
RANK_SUB_REPLICAS=3
SUB_WORKER_COUNT=3
TOP_K=100
SUB_WORKER_TIMEOUT_MS=5000
SCORING_DELAY_MS=100
RANK_SUB_STARTUP_TIMEOUT=120
