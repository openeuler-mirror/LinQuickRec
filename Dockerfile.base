# 基础镜像：包含 BRPC、Protobuf、元戎等依赖
FROM ubuntu:22.04

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

# 安装基础依赖
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    libssl-dev \
    protobuf-compiler \
    libprotobuf-dev \
    libgrpc++-dev \
    libgrpc-dev \
    protobuf-compiler-grpc \
    libcurl4-openssl-dev \
    libabsl-dev \
    libhiredis-dev \
    && rm -rf /var/lib/apt/lists/*

# 安装元戎 (OneDNN) - 根据实际需求调整版本和安装方式
RUN apt-get install -y wget && \
    wget https://github.com/one-project/onednn/releases/download/v3.5.2/oneDNN-v3.5.2-linux.tar.gz && \
    tar -xzf oneDNN-v3.5.2-linux.tar.gz -C /opt && \
    rm oneDNN-v3.5.2-linux.tar.gz

# 设置 OneDNN 环境变量
ENV ONEDNN_ROOT=/opt/oneDNN-v3.5.2
ENV LD_LIBRARY_PATH=${ONEDNN_ROOT}/lib:${LD_LIBRARY_PATH}

# 安装 BRPC (如果包管理器没有，需要从源码编译)
# RUN git clone https://github.com/apache/incubator-brpc.git /tmp/brpc && \
#     cd /tmp/brpc && \
#     mkdir build && cd build && \
#     cmake .. && make -j$(nproc) && make install

WORKDIR /app

# 默认命令
CMD ["/bin/bash"]
